# ClaimKavach — Environment Configuration
# Get your Gemini API key from Google AI Studio: https://aistudio.google.com/
# Can be configured here on the server or provided by users per-request via x-gemini-key header.
GEMINI_API_KEY=

# Gemini model (server-only). Required when EXTRACT_MOCK=0 (no default fallback; must be configured).
# Recommended: gemini-1.5-pro or gemini-2.0-flash
GEMINI_MODEL=gemini-1.5-pro

# Max upload size in MB (enforced on incoming files in /api/extract)
MAX_UPLOAD_MB=4

# Rate limit: max requests per minute per IP (in-memory per serverless instance)
RATE_LIMIT_PER_MIN=10

# Set to 1 to bypass Gemini and return synthetic sample fixtures during local development.
# Strictly ignored when NODE_ENV === 'production'.
EXTRACT_MOCK=0
